{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gotoo77/gotoo-pc-bench/blob/main/docs/schema/result-v1.schema.json",
  "title": "Gotoo PC Bench - result document v1",
  "description": "File basename must match run.id. Metric units/directions and duplicate keys are additionally verified by the Go validator. Schema version does not imply benchmark-protocol comparability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "complete",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rapport_[A-Za-z0-9_-]+\\.(txt|json)$",
          "maxLength": 255
        },
        "complete": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "label",
              "value",
              "unit",
              "higher_is_better"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^(cpu|ram|ffmpeg|go)\\.[1-9][0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "événements/s",
                  "MiB/s",
                  "s"
                ]
              },
              "higher_is_better": {
                "type": "boolean"
              }
            }
          }
        },
        "timestamp": {
          "type": "string",
          "maxLength": 512,
          "format": "date-time"
        },
        "os": {
          "type": "string",
          "maxLength": 512
        },
        "kernel": {
          "type": "string",
          "maxLength": 512
        },
        "cpu": {
          "type": "string",
          "maxLength": 512
        },
        "cores": {
          "type": "string",
          "maxLength": 512
        },
        "threads": {
          "type": "string",
          "maxLength": 512
        },
        "ram": {
          "type": "string",
          "maxLength": 512
        },
        "board": {
          "type": "string",
          "maxLength": 512
        },
        "bios": {
          "type": "string",
          "maxLength": 512
        },
        "ffmpeg_version": {
          "type": "string",
          "maxLength": 512
        },
        "sysbench_version": {
          "type": "string",
          "maxLength": 512
        },
        "go_version": {
          "type": "string",
          "maxLength": 512
        },
        "video_sha256": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "video_spec": {
          "type": "string",
          "maxLength": 512
        },
        "go_checksum": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
